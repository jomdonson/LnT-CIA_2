// Task 9: Report remaining time each second and notify separately at the end.

let secondsLeft = 5;

const countdown = setInterval(() => {
    console.log(`${secondsLeft} second(s) left`);
    secondsLeft -= 1;

    if (secondsLeft === 0) {
        clearInterval(countdown);
    }
}, 1000);

setTimeout(() => {
    console.log("Time's up!");
}, 5000);
