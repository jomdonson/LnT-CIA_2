function countdown(seconds) {
    if (seconds === 0) {
        console.log("Time is up!");
        return;
    }

    console.log("Time left:", seconds);

    setTimeout(() => {
        countdown(seconds - 1);
    }, 1000);
}

module.exports = {
    countdown
};


