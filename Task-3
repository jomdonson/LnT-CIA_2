// Task 3: Basic five-second countdown.
// Timers module methods used: setInterval() and clearInterval().

let secondsLeft = 5;

const countdown = setInterval(() => {
    console.log(`${secondsLeft} second(s) left`);
    secondsLeft -= 1;

    if (secondsLeft === 0) {
        clearInterval(countdown);
        console.log("Time's up!");
    }
}, 1000);
